
import { useEffect, useState } from 'react';
import { Text, View } from 'react-native';
export default function App() {
  const [mensagem, setMensagem] = useState('Carregando...');
  useEffect(() => {
    setMensagem('Aplicativo iniciado!');
  }, []);
  return (
    <View>
      <Text>{mensagem}</Text>
    </View>
  );
}
