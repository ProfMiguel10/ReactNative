    id: '10',
    nome: 'Gestão da Tecnologia da Informação',
    categoria: 'Tecnólogo',
    duracao: '5 semestres'
  }
];

const ITENS_POR_PAGINA = 3;

export default function App() {
  const [pesquisa, setPesquisa] = useState('');
  const [categoria, setCategoria] = useState('Todos');
  const [pagina, setPagina] = useState(1);

  const cursosFiltrados = cursos.filter((curso) => {
    const correspondePesquisa =
      curso.nome
        .toLowerCase()
        .includes(pesquisa.trim().toLowerCase());

    const correspondeCategoria =
      categoria === 'Todos' ||
      curso.categoria === categoria;

    return correspondePesquisa && correspondeCategoria;
  });

  const totalPaginas = Math.max(
    1,
    Math.ceil(
      cursosFiltrados.length / ITENS_POR_PAGINA
    )
  );

  const paginaAtual = Math.min(pagina, totalPaginas);

  const inicio = (paginaAtual - 1) * ITENS_POR_PAGINA;

  const cursosDaPagina = cursosFiltrados.slice(
    inicio,
    inicio + ITENS_POR_PAGINA
  );

  function alterarPesquisa(texto) {
    setPesquisa(texto);
    setPagina(1);
  }

  function alterarCategoria(novaCategoria) {
    setCategoria(novaCategoria);
    setPagina(1);
  }

  function mudarPagina(novaPagina) {
    if (novaPagina >= 1 && novaPagina <= totalPaginas) {
      setPagina(novaPagina);
    }
  }

  function renderizarCurso({ item }) {
    return (
      <View style={styles.cartao}>
        <Text style={styles.nomeCurso}>
          {item.nome}
        </Text>

        <Text style={styles.detalhe}>
          Categoria: {item.categoria}
        </Text>

        <Text style={styles.detalhe}>
          Duração: {item.duracao}
        </Text>
      </View>
    );
  }

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>
        Catálogo de cursos
      </Text>

      <Text style={styles.subtitulo}>
        Pesquise, filtre e navegue pelos resultados.
      </Text>

      <TextInput
        style={styles.pesquisa}
        placeholder="Pesquisar curso..."
        value={pesquisa}
        onChangeText={alterarPesquisa}
        autoCapitalize="none"
        clearButtonMode="while-editing"
      />

      <Text style={styles.rotulo}>
        Filtrar por categoria
      </Text>

      <View style={styles.filtros}>
        {['Todos', 'Bacharelado', 'Tecnólogo'].map(
          (opcao) => {
            const selecionada = categoria === opcao;

            return (
              <Pressable
                key={opcao}
                style={[
                  styles.botaoFiltro,
                  selecionada && styles.filtroSelecionado
                ]}
                onPress={() => alterarCategoria(opcao)}
              >
                <Text
                  style={[
                    styles.textoFiltro,
                    selecionada &&
                      styles.textoFiltroSelecionado
                  ]}
                >
                  {opcao}
                </Text>
              </Pressable>
            );
          }
        )}
      </View>

      <Text style={styles.contagem}>
        {cursosFiltrados.length} curso(s) encontrado(s)
      </Text>

      <FlatList
        data={cursosDaPagina}
        renderItem={renderizarCurso}
        keyExtractor={(item) => item.id}
        contentContainerStyle={styles.lista}
        ListEmptyComponent={
          <Text style={styles.vazio}>
            Nenhum curso encontrado.
            {'\n'}
            Experimente alterar a pesquisa ou o filtro.
          </Text>
        }
      />

      <View style={styles.paginacao}>
        <Pressable
          style={[
            styles.botaoPagina,
            paginaAtual === 1 && styles.botaoDesabilitado
          ]}
          disabled={paginaAtual === 1}
          onPress={() => mudarPagina(paginaAtual - 1)}
        >
          <Text style={styles.textoPagina}>
            Anterior
          </Text>
        </Pressable>

        <Text style={styles.numeroPagina}>
          Página {paginaAtual} de {totalPaginas}
        </Text>

        <Pressable
          style={[
            styles.botaoPagina,
            paginaAtual === totalPaginas &&
              styles.botaoDesabilitado
          ]}
          disabled={paginaAtual === totalPaginas}
          onPress={() => mudarPagina(paginaAtual + 1)}
        >
          <Text style={styles.textoPagina}>
            Próxima
          </Text>
        </Pressable>
      </View>
    </View>
  );
}

