import React, { useState } from 'react';
import {
  View,
  Text,
  Button,
  ActivityIndicator,
  StyleSheet
} from 'react-native';

export default function App() {
  const [contador, setContador] = useState(0);
  const [atualizando, setAtualizando] = useState(false);
  const [status, setStatus] = useState('Tudo pronto.');

  async function atualizar() {
    if (atualizando) return;

    setAtualizando(true);
    setStatus('Atualizando a interface...');

    try {
      await new Promise(resolve => setTimeout(resolve, 1200));
      setContador(valor => valor + 1);
      setStatus('Atualização realizada!');
    } catch (erro) {
      setStatus('Ocorreu um problema.');
    } finally {
      setAtualizando(false);
    }
  }

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Painel dinâmico</Text>

      <Text style={styles.contador}>
        Atualizações: {contador}
      </Text>

      {atualizando && (
        <ActivityIndicator size="large" color="#7c3aed" />
      )}

      <Text>{status}</Text>

      <Button
        title="Atualizar"
        onPress={atualizar}
        disabled={atualizando}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    padding: 24,
    gap: 20
  },
  titulo: {
    fontSize: 25,
    fontWeight: 'bold'
  },
  contador: {
    fontSize: 22
  }
});
