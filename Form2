
import { useState } from 'react';

import {
  StyleSheet,
  Text,
  TextInput,
  View
} from 'react-native';

// 1. Definição das propriedades do componente
type CampoTextoProps = {
  rotulo: string;
  valor: string;
  placeholder: string;
  aoAlterar: (texto: string) => void;
};

// 2. Criação do componente reutilizável
function CampoTexto({
  rotulo,
  valor,
  placeholder,
  aoAlterar
}: CampoTextoProps) {

  return (
    <View style={styles.grupo}>

      <Text style={styles.rotulo}>
        {rotulo}
      </Text>

      <TextInput
        style={styles.entrada}
        value={valor}
        onChangeText={aoAlterar}
        placeholder={placeholder}
      />

    </View>
  );
}

// 3. Componente principal da aplicação
export default function App() {

  // Estados dos campos do formulário
  const [nome, setNome] = useState('');
  const [email, setEmail] = useState('');

  return (
    <View style={styles.container}>

      <Text style={styles.titulo}>
        Cadastro de estudante
      </Text>

      <Text style={styles.descricao}>
        Preencha os campos abaixo:
      </Text>

      {/* Campo para informar o nome */}
      <CampoTexto
        rotulo="Nome completo"
        valor={nome}
        placeholder="Digite seu nome"
        aoAlterar={setNome}
      />

      {/* Campo para informar o e-mail */}
      <CampoTexto
        rotulo="E-mail"
        valor={email}
        placeholder="Digite seu e-mail"
        aoAlterar={setEmail}
      />

      {/* Exibição dos dados digitados */}
      <View style={styles.resultado}>

        <Text style={styles.subtitulo}>
          Dados informados
        </Text>

        <Text style={styles.texto}>
          Nome: {nome || 'Não informado'}
        </Text>

        <Text style={styles.texto}>
          E-mail: {email || 'Não informado'}
        </Text>

      </View>

    </View>
  );
}

// 4. Estilização da interface
