import React, { useState } from 'react';

import {
  KeyboardAvoidingView,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
  useWindowDimensions
} from 'react-native';

// Opções de prioridade
const PRIORIDADES = ['Baixa', 'Média', 'Alta'];

export default function App() {

  // Identifica a largura da tela
  const { width } = useWindowDimensions();

  // Verifica se a tela é ampla
  const telaAmpla = width >= 700;

  // Estados do formulário
  const [titulo, setTitulo] = useState('');
  const [disciplina, setDisciplina] = useState('');
  const [prioridade, setPrioridade] = useState('Média');

  // Armazena as atividades cadastradas
  const [atividades, setAtividades] = useState([]);

  // Armazena mensagens de erro
  const [erro, setErro] = useState('');

  // Função para cadastrar uma atividade
  function cadastrarAtividade() {

    const tituloLimpo = titulo.trim();
    const disciplinaLimpa = disciplina.trim();

    // Verifica se os campos foram preenchidos
    if (!tituloLimpo || !disciplinaLimpa) {
      setErro('Preencha o título e a disciplina antes de cadastrar.');
      return;
    }

    // Cria uma nova atividade
    const novaAtividade = {
      id: `${Date.now()}-${Math.random()}`,
      titulo: tituloLimpo,
      disciplina: disciplinaLimpa,
      prioridade: prioridade
    };

    // Adiciona a atividade à lista
    setAtividades(listaAtual => [
      novaAtividade,
      ...listaAtual
    ]);

    // Limpa os campos
    setTitulo('');
    setDisciplina('');
    setPrioridade('Média');
    setErro('');
  }

  // Função para remover uma atividade
  function removerAtividade(id) {

    setAtividades(listaAtual =>
      listaAtual.filter(
        atividade => atividade.id !== id
      )
    );
  }

  return (

    <KeyboardAvoidingView
      style={styles.tela}
      behavior={Platform.OS === 'ios' ? 'padding' : undefined}
    >

      <ScrollView
        keyboardShouldPersistTaps="handled"
        contentContainerStyle={[
          styles.conteudo,
          telaAmpla && styles.conteudoAmplo
        ]}
      >

        {/* CABEÇALHO */}

        <Text style={styles.titulo}>
          Organizador acadêmico
        </Text>

        <Text style={styles.subtitulo}>
          Cadastre e acompanhe suas atividades.
        </Text>

        <View
          style={[
            styles.layout,
            telaAmpla && styles.layoutAmplo
          ]}
        >

          {/* FORMULÁRIO DE CADASTRO */}

          <View style={styles.formulario}>

            <Text style={styles.tituloSecao}>
              Nova atividade
            </Text>

            {/* Campo título */}

            <Text style={styles.rotulo}>
              Título
            </Text>

            <TextInput
              style={styles.entrada}
              placeholder="Ex.: Revisar exercícios"
              value={titulo}
              onChangeText={setTitulo}
              maxLength={100}
              returnKeyType="next"
            />

            {/* Campo disciplina */}

            <Text style={styles.rotulo}>
              Disciplina
            </Text>

            <TextInput
              style={styles.entrada}
              placeholder="Ex.: Estrutura de Dados"
              value={disciplina}
              onChangeText={setDisciplina}
              maxLength={80}
              returnKeyType="done"
            />

            {/* Seleção de prioridade */}

            <Text style={styles.rotulo}>
              Prioridade
            </Text>

            <View style={styles.prioridades}>

              {PRIORIDADES.map(opcao => {

                const selecionada = prioridade === opcao;

                return (

                  <Pressable
                    key={opcao}
                    onPress={() => setPrioridade(opcao)}
                    accessibilityRole="button"
                    accessibilityState={{
                      selected: selecionada
                    }}
                    style={[
                      styles.opcaoPrioridade,
                      selecionada && styles.opcaoSelecionada
                    ]}
                  >

                    <Text
                      style={[
                        styles.textoOpcao,
                        selecionada && styles.textoOpcaoSelecionada
                      ]}
                    >
                      {opcao}
                    </Text>

                  </Pressable>

                );

              })}

            </View>

            {/* Mensagem de erro */}

            {erro ? (

              <Text style={styles.erro}>
                {erro}
              </Text>

            ) : null}

            {/* BOTÃO DE CADASTRO */}

            <Pressable
              style={({ pressed }) => [
                styles.botao,
                pressed && styles.botaoPressionado
              ]}
              onPress={cadastrarAtividade}
              accessibilityRole="button"
            >

              <Text style={styles.textoBotao}>
                Cadastrar atividade
              </Text>

            </Pressable>

          </View>

          {/* LISTA DE ATIVIDADES */}

          <View style={styles.lista}>

            <Text style={styles.tituloSecao}>
              Atividades cadastradas
            </Text>

            <Text style={styles.contador}>
              Total: {atividades.length}
            </Text>

            {/* Verifica se existem atividades */}

            {atividades.length === 0 ? (

              <Text style={styles.vazio}>
                Nenhuma atividade cadastrada.
              </Text>

            ) : (

              atividades.map(atividade => (

                <View
                  key={atividade.id}
                  style={styles.cartaoAtividade}
                >

                  <Text style={styles.tituloAtividade}>
                    {atividade.titulo}
                  </Text>

                  <Text style={styles.textoSecundario}>
                    Disciplina: {atividade.disciplina}
                  </Text>

                  <Text style={styles.textoSecundario}>
                    Prioridade: {atividade.prioridade}
                  </Text>

                  {/* Botão para remover */}

                  <Pressable
                    onPress={() => removerAtividade(atividade.id)}
                    accessibilityRole="button"
                    accessibilityLabel={`Remover atividade ${atividade.titulo}`}
                    style={styles.botaoRemover}
                  >

                    <Text style={styles.textoRemover}>
                      Remover
                    </Text>

                  </Pressable>

                </View>

              ))

            )}

          </View>

        </View>

      </ScrollView>

    </KeyboardAvoidingView>

  );
}

