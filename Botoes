  container: {
    flexGrow: 1,
    backgroundColor: '#f2f5f9',
    padding: 24,
    paddingTop: 45,
    paddingBottom: 40
  },

  titulo: {
    fontSize: 23,
    fontWeight: 'bold',
    color: '#17365d',
    marginBottom: 25,
    textAlign: 'center'
  },

  secao: {
    fontSize: 16,
    fontWeight: 'bold',
    color: '#243b53',
    marginTop: 20,
    marginBottom: 10
  },

  botao: {
    backgroundColor: '#17365d',
    padding: 14,
    borderRadius: 8,
    alignItems: 'center'
  },

  botaoPressionado: {
    opacity: 0.65,
    transform: [{ scale: 0.97 }]
  },

  botaoVerde: {
    backgroundColor: '#16803c',
    padding: 14,
    borderRadius: 8,
    alignItems: 'center'
  },

  botaoFavorito: {
    backgroundColor: '#d97706'
  },

  botaoDesabilitado: {
    backgroundColor: '#9ca3af',
    opacity: 0.6
  },

  botaoSecundario: {
    borderWidth: 1,
    borderColor: '#17365d',
    padding: 12,
    borderRadius: 8,
    marginTop: 8,
    alignItems: 'center'
  },

  botaoVermelho: {
    backgroundColor: '#c0392b',
    padding: 14,
    borderRadius: 8,
    alignItems: 'center'
  },

  textoBotao: {
    color: '#ffffff',
    fontSize: 15,
    fontWeight: 'bold'
  },

  textoSecundario: {
    color: '#17365d',
    fontWeight: 'bold'
  },

  resultado: {
    fontSize: 16,
    color: '#16803c',
    fontWeight: 'bold',
    marginTop: 10
  },

  mensagem: {
    backgroundColor: '#dff5e5',
    color: '#166534',
    padding: 12,
    borderRadius: 8,
    marginTop: 20,
    fontWeight: 'bold',
    textAlign: 'center'
  }

});
