import React, { useState } from 'react';

import {
  View,
  Text,
  TextInput,
  Pressable,
  ScrollView,
  StyleSheet,
  ActivityIndicator,
  KeyboardAvoidingView,
  Platform
} from 'react-native';

export default function App() {
  const [apiKey, setApiKey] = useState('');
  const [pergunta, setPergunta] = useState('');
  const [mensagens, setMensagens] = useState([]);
  const [carregando, setCarregando] = useState(false);

  // Temas que o usuário pode explorar
  const sugestoes = [
    'Explique Inteligência Artificial',
    'Crie uma ideia de aplicativo',
    'Ensine React Native',
    'Crie um desafio de programação'
  ];

  // Envia a pergunta para a IA Gemini
  async function consultarIA(texto = pergunta) {
    if (!apiKey.trim()) {
      alert('Informe sua chave de API Gemini.');
      return;
    }

    if (!texto.trim() || carregando) return;

    const novaMensagem = {
      tipo: 'usuario',
      texto: texto
    };

    const historico = [...mensagens, novaMensagem];

    setMensagens(historico);
    setPergunta('');
    setCarregando(true);

    try {
      // Organiza o histórico para dar contexto à IA
      const contexto = historico.map(item =>
        `${item.tipo === 'usuario' ? 'Usuário' : 'IA'}: ${item.texto}`
      ).join('\n\n');

      const resposta = await fetch(
        'https://generativelanguage.googleapis.com/v1beta/interactions',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-goog-api-key': apiKey.trim()
          },
          body: JSON.stringify({
            model: 'gemini-3.8-flash',
            input:
              'Você é o IAdea, um assistente inteligente, ' +
              'criativo, didático e amigável. Responda em português ' +
              'brasileiro, com clareza e exemplos práticos. ' +
              'Ajude principalmente com tecnologia, programação, ' +
              'educação e criatividade.\n\n' +
              contexto
          })
        }
      );

      const dados = await resposta.json();

      if (!resposta.ok) {
        throw new Error(
          dados.error?.message || 'Erro ao consultar a IA.'
        );
      }

      const textoResposta =
        dados.output_text ||
        'Não foi possível interpretar a resposta da IA.';

      setMensagens(atual => [
        ...atual,
        {
          tipo: 'ia',
          texto: textoResposta
        }
      ]);

    } catch (erro) {
      setMensagens(atual => [
        ...atual,
        {
          tipo: 'ia',
          texto: 'Não consegui responder. Verifique sua chave ' +
            'de API e sua conexão. Detalhe: ' + erro.message
        }
      ]);
    } finally {
      setCarregando(false);
    }
  }

  return (
    <KeyboardAvoidingView
      style={styles.container}
      behavior={Platform.OS === 'ios' ? 'padding' : undefined}
    >

      <View style={styles.header}>
        <Text style={styles.logo}>✦ IAdea</Text>
        <Text style={styles.subtitulo}>
          Seu laboratório de ideias inteligentes
        </Text>
      </View>

      <View style={styles.configuracao}>
        <Text style={styles.label}>Chave de API Gemini</Text>

        <TextInput
          style={styles.chave}
          placeholder="Cole sua chave de API"
          placeholderTextColor="#999"
          value={apiKey}
          onChangeText={setApiKey}
          secureTextEntry
          autoCapitalize="none"
        />

        <Text style={styles.aviso}>
          A chave é utilizada nesta sessão.
        </Text>
      </View>

      <ScrollView
        style={styles.conversa}
        contentContainerStyle={styles.conteudo}
        keyboardShouldPersistTaps="handled"
      >

        {mensagens.length === 0 && (
          <View style={styles.boasVindas}>
            <Text style={styles.emoji}>🤖</Text>

            <Text style={styles.titulo}>
              Olá! Como posso ajudar?
            </Text>

            <Text style={styles.descricao}>
              Sou o IAdea. Posso explicar conceitos,
              criar projetos, sugerir soluções e
              ajudar você a programar.
            </Text>

            <Text style={styles.labelSugestao}>
              EXPERIMENTE UMA IDEIA
            </Text>

            {sugestoes.map((item, index) => (
              <Pressable
                key={index}
                style={styles.sugestao}
                onPress={() => consultarIA(item)}
              >
                <Text style={styles.textoSugestao}>
                  ✨ {item}
                </Text>
              </Pressable>
            ))}
          </View>
        )}

        {mensagens.map((item, index) => (
          <View
            key={index}
            style={[
              styles.balao,
              item.tipo === 'usuario'
                ? styles.balaoUsuario
                : styles.balaoIA
            ]}
          >
            <Text style={styles.identificacao}>
              {item.tipo === 'usuario' ? 'VOCÊ' : '✦ IADEA'}
            </Text>

            <Text style={styles.textoMensagem}>
              {item.texto}
            </Text>
          </View>
        ))}

        {carregando && (
          <View style={styles.carregando}>
            <ActivityIndicator color="#A78BFA" />
            <Text style={styles.textoCarregando}>
              A IA está pensando...
            </Text>
          </View>
        )}

      </ScrollView>

      <View style={styles.rodape}>
        <TextInput
          style={styles.entrada}
          placeholder="Digite sua pergunta..."
          placeholderTextColor="#999"
          value={pergunta}
          onChangeText={setPergunta}
          multiline
        />

        <Pressable
          style={styles.botao}
          onPress={() => consultarIA()}
          disabled={carregando}
        >
          <Text style={styles.textoBotao}>➤</Text>
        </Pressable>
      </View>

      <Text style={styles.credito}>
        Desenvolvido com React Native + Gemini AI
      </Text>

    </KeyboardAvoidingView>
  );
}

