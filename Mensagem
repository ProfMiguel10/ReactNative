import { useState } from 'react';
import { Text, TextInput, View } from 'react-native';

export default function App() {
  const [nome, setNome] = useState('');

  return (
    <View>
      <TextInput
        placeholder="Digite seu nome"
        value={nome}
        onChangeText={setNome}
      />

      <Text>Olá, {nome || 'estudante'}!</Text>
    </View>
  );
}
